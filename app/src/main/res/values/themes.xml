<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GameTurboPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary branding colors -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary branding colors -->
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSecondaryVariant">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_amoled</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar and nav bar -->
        <item name="android:statusBarColor">@color/bg_amoled</item>
        <item name="android:navigationBarColor">@color/nav_bar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Alias for backwards compatibility with manifest template -->
    <style name="Theme.MyApplication" parent="Theme.GameTurboPro" />
</resources>
