<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_amoled"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Gaming Accent Theme"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Customizes HUD glow, neon borders, and buttons"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rg_accent_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rb_accent_cyan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_cyan"
            android:paddingVertical="8dp"
            android:text="Electric Cyan (Default Cyber)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_accent_lime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_lime"
            android:paddingVertical="8dp"
            android:text="Toxic Lime (Razer Speed)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_accent_purple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_purple"
            android:paddingVertical="8dp"
            android:text="Ultra Violet (Neon Synthwave)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_accent_orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_orange"
            android:paddingVertical="8dp"
            android:text="Solar Blaze (Overclock Orange)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_accent_red"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_red"
            android:paddingVertical="8dp"
            android:text="Crimson Fury (Apex Red)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_accent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/accent_cyan"
        android:text="Apply Accent"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:cornerRadius="10dp" />
</LinearLayout>
